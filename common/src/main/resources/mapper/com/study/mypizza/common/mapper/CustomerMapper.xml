<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.mypizza.common.mapper.CommonMapper">

    <!--  Member insert쿼리-->
    <insert id="insertMember">

        <selectKey keyProperty="customer_no" resultType="int" order="BEFORE">
            SELECT NEXT VALUE FOR member_seq
        </selectKey>

        INSERT INTO member (member_Id, username, age)
        VALUES (#{member_Id}, #{member.username}, #{member.age})
    </insert>

    <!--  Member select 쿼리-->
    <select id="selectCustomer" resultType="com.study.mypizza.common.dto.CustomerDto">
        SELECT * FROM T_CUSTOMER
        WHERE EMAIL = #{email}
    </select>

    <delete id="delOrderDetail" parameterType="java.lang.String">
        DELETE FROM t_orderdetail
    </delete>

    <delete id="delOrder" parameterType="java.lang.String">
        DELETE FROM t_order
    </delete>

    <delete id="delMyPageOrderDetail" parameterType="java.lang.String">
        DELETE FROM t_mypage_orderdetail
    </delete>

    <delete id="delMyPage" parameterType="java.lang.String">
        DELETE FROM t_mypage
    </delete>

    <delete id="delStoreOrderDetail" parameterType="java.lang.String">
        DELETE FROM t_store_orderdetail
    </delete>

    <delete id="delStoreOrder" parameterType="java.lang.String">
        DELETE FROM t_store_order
    </delete>

    <delete id="delDelivery" parameterType="java.lang.String">
        DELETE FROM t_delivery
    </delete>

    <delete id="delPendingEvent" parameterType="java.lang.String">
        DELETE FROM t_pending_event
    </delete>
</mapper>